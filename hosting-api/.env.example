# Random secret shared between Next.js and this API
# Generate: openssl rand -hex 32
HOSTING_API_SECRET=your-secret-here

# Fernet key for encrypting Discord bot tokens at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HOSTING_ENCRYPTION_KEY=your-fernet-key-here
